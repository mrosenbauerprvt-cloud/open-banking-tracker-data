# Kopiere diese Datei zu ".env" und trage Deinen Schlüssel ein.
# Den API-Schlüssel bekommst Du unter: https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-hier-deinen-schluessel-einfuegen

# Optional: Port ändern (Standard 3000)
# PORT=3000

# Admin-Zugang: Trage hier Deine E-Mail ein – dieses Konto wird automatisch Admin.
# (Ohne Eintrag wird der ALLERERSTE registrierte Nutzer automatisch Admin.)
# ADMIN_EMAIL=m.rosenbauer.prvt@gmail.com

# Optional: Für ECHTE Bezahlung über Stripe.
# Schlüssel aus dem Stripe-Dashboard: https://dashboard.stripe.com/apikeys
# Ohne diesen Schlüssel läuft die Bezahlung im Demo-/Mock-Modus.
# STRIPE_SECRET_KEY=sk_test_...
